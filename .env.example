# Baza
DB_DATABASE=avtomobili
DB_USERNAME=cars_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# JWT: dolg naključen niz, ustvariš ga z:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Naslovi in vrata
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=80
BACKEND_PORT=8000

# Neobvezno: ob zagonu backenda se ustvari administrator (če sta oba nastavljena)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Ali naj se ob zagonu naložijo vzorčni avtomobili (true/false)
SEED_SAMPLE_DATA=true
